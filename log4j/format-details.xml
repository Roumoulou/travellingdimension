<?xml version="1.0" encoding="UTF-8"?>
<!--
    Format de console « details », héritier du profil info-details-v2 d'Enhanced
    Terminal Logging : deux lignes par log, la première situe (heure aux millisecondes,
    PID, 📍 Classe::Méthode(Ligne) en bleu souligné), la seconde porte le logger, le
    niveau avec son emoji et le message. Sans les plugins custom d'ETL : tout ici est
    du log4j2 standard.

    Le calcul de la localisation (%C, %M, %L) a un coût : c'est le format du diagnostic
    poussé, pas celui de tous les jours.

    Branché par la clé `dev_log_format=details` de gradle.properties (section 7 du
    build) : ce fichier REDÉFINIT alors l'appender SysOut de la config Loom et ne
    touche qu'à la console ; les filtres anti-bruit d'authentification de Loom sont
    recopiés. Couleurs actives par défaut, -Dfabric.log.disableAnsi=true les coupe.

    Rendu type :
        [19:54:59.123] (PID:4242) 📍 fr.roumoulou.travellingdimension.registry.ModBlocks::register(L:46)
         ╰─❯ 🏷️ [travellingdimension] 🐛 [main/DEBUG] Blocs enregistrés : ...
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="SysOut" target="SYSTEM_OUT">
            <Filters>
                <RegexFilter regex="^Failed to verify authentication$" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex="^Failed to fetch user properties$" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex="^Couldn't connect to realms$" onMatch="DENY" onMismatch="NEUTRAL"/>
                <RegexFilter regex="^Failed to fetch Realms feature flags$" onMatch="DENY" onMismatch="NEUTRAL"/>
            </Filters>
            <PatternLayout disableAnsi="${sys:fabric.log.disableAnsi:-false}">
                <LevelPatternSelector defaultPattern="%style{[%d{HH:mm:ss.SSS}]}{bright_black} %style{(PID:%pid)}{magenta} %style{📍 %C::%M(L:%L)}{blue,underline}%style{%notEmpty{ 🔖 [%marker]}}{bright_magenta}%n ╰─❯ %style{🏷️ [%logger{1}]}{bright_magenta} %highlight{❓ [%t/%level]}{FATAL=bright_red bold} %msg%n%highlight{%rEx}{FATAL=bright_red}">
                    <PatternMatch key="TRACE"
                                  pattern="%style{[%d{HH:mm:ss.SSS}]}{bright_black} %style{(PID:%pid)}{magenta} %style{📍 %C::%M(L:%L)}{blue,underline}%style{%notEmpty{ 🔖 [%marker]}}{bright_magenta}%n ╰─❯ %style{🏷️ [%logger{1}]}{bright_magenta} %highlight{🔍 [%t/TRACE]}{TRACE=bright_black bold} %msg%n%highlight{%rEx}{TRACE=bright_black}"/>
                    <PatternMatch key="DEBUG"
                                  pattern="%style{[%d{HH:mm:ss.SSS}]}{bright_black} %style{(PID:%pid)}{magenta} %style{📍 %C::%M(L:%L)}{blue,underline}%style{%notEmpty{ 🔖 [%marker]}}{bright_magenta}%n ╰─❯ %style{🏷️ [%logger{1}]}{bright_magenta} %highlight{🐛 [%t/DEBUG]}{DEBUG=cyan bold} %msg%n%highlight{%rEx}{DEBUG=cyan}"/>
                    <PatternMatch key="INFO"
                                  pattern="%style{[%d{HH:mm:ss.SSS}]}{bright_black} %style{(PID:%pid)}{magenta} %style{📍 %C::%M(L:%L)}{blue,underline}%style{%notEmpty{ 🔖 [%marker]}}{bright_magenta}%n ╰─❯ %style{🏷️ [%logger{1}]}{bright_magenta} %highlight{✅ [%t/INFO]}{INFO=bright_green bold} %msg%n%highlight{%rEx}{INFO=bright_green}"/>
                    <PatternMatch key="WARN"
                                  pattern="%style{[%d{HH:mm:ss.SSS}]}{bright_black} %style{(PID:%pid)}{magenta} %style{📍 %C::%M(L:%L)}{blue,underline}%style{%notEmpty{ 🔖 [%marker]}}{bright_magenta}%n ╰─❯ %style{🏷️ [%logger{1}]}{bright_magenta} %highlight{⚠️ [%t/WARN]}{WARN=bright_yellow bold} %msg%n%highlight{%rEx}{WARN=bright_yellow}"/>
                    <PatternMatch key="ERROR"
                                  pattern="%style{[%d{HH:mm:ss.SSS}]}{bright_black} %style{(PID:%pid)}{magenta} %style{📍 %C::%M(L:%L)}{blue,underline}%style{%notEmpty{ 🔖 [%marker]}}{bright_magenta}%n ╰─❯ %style{🏷️ [%logger{1}]}{bright_magenta} %highlight{🔥 [%t/ERROR]}{ERROR=bright_red bold} %msg%n%highlight{%rEx}{ERROR=bright_red}"/>
                    <PatternMatch key="FATAL"
                                  pattern="%style{[%d{HH:mm:ss.SSS}]}{bright_black} %style{(PID:%pid)}{magenta} %style{📍 %C::%M(L:%L)}{blue,underline}%style{%notEmpty{ 🔖 [%marker]}}{bright_magenta}%n ╰─❯ %style{🏷️ [%logger{1}]}{bright_magenta} %highlight{💀 [%t/FATAL]}{FATAL=bright_red bold} %style{%msg}{bright_red bold}%n%highlight{%rEx}{FATAL=bright_red bold}"/>
                </LevelPatternSelector>
            </PatternLayout>
        </Console>
    </Appenders>
</Configuration>
